{
  "openapi": "3.0.0",
  "paths": {
    "/gatherings": {
      "get": {
        "description": "根據查詢參數（如狀態、關鍵字等）來取得目前的聚會清單",
        "operationId": "GatheringsController_getGatherings",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "頁數",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "每頁筆數",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "sortBy",
            "required": false,
            "in": "query",
            "description": "排序欄位",
            "schema": {
              "type": "string",
              "enum": [
                "id",
                "participantNumbers",
                "price",
                "status",
                "type",
                "startTime",
                "deadline",
                "createdAt"
              ]
            }
          },
          {
            "name": "sortOrder",
            "required": false,
            "in": "query",
            "description": "排序方式（升冪 ASC / 降冪 DESC）",
            "schema": {
              "type": "string",
              "enum": [
                "ASC",
                "DESC"
              ]
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "結束狀態",
            "schema": {
              "type": "string",
              "enum": [
                "OPEN",
                "UPCOMING",
                "CLOSED"
              ]
            }
          },
          {
            "name": "type",
            "required": false,
            "in": "query",
            "description": "聚會分類",
            "schema": {
              "type": "string",
              "enum": [
                "PARTY",
                "MUSIC",
                "LEARNING",
                "EXHIBITION",
                "TRAVEL",
                "SPORTS",
                "GAME",
                "FOOD",
                "OTHER"
              ]
            }
          },
          {
            "name": "isArchived",
            "required": false,
            "in": "query",
            "description": "是否封存",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "模糊搜尋關鍵字",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tags",
            "required": false,
            "in": "query",
            "description": "標籤（可以傳多個）",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "查詢聚會列表",
        "tags": [
          "Gatherings"
        ]
      },
      "post": {
        "description": "建立一筆新的聚會，並回傳建立成功的資料",
        "operationId": "GatheringsController_createGathering",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGatheringDto"
              },
              "examples": {
                "only": {
                  "value": {
                    "title": "游泳活動",
                    "description": "週末一起去游泳吧！僅限定成年人參加",
                    "location": "市立游泳池",
                    "participantNumbers": 20,
                    "price": 300,
                    "type": "SPORTS",
                    "startTime": "2026-12-19 14:00:00",
                    "deadline": "2026-12-09 18:00:00",
                    "tags": [
                      "游泳"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "新增聚會",
        "tags": [
          "Gatherings"
        ]
      }
    },
