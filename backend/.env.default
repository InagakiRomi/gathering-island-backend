# App
PORT=3000
STAGE=dev

# Database
# SQLite 資料庫設定
# 如果不指定 DB_NAME，預設位置為 data/gathering.db
DB_NAME=data/gathering.db

# 時區設定
APP_TIMEZONE=Asia/Taipei

# JWT 認證設定
JWT_ACCESS_SECRET=my_very_secret_key_for_access_token
JWT_REFRESH_SECRET=my_other_super_secret_refresh_key
JWT_ACCESS_EXPIRES=7889400000 # 3 個月 (7889400000毫秒)
JWT_REFRESH_EXPIRES=15778800000 # 6 個月 (15778800000毫秒)
JWT_COOKIE_SECRET=my-very-strong-random-secret-string
